#!/bin/sh
# Jumpkut is one self-contained binary; graphics, Wayland, X11 and font
# libraries come from the host (they are loaded at run time).
# JUMPKUT_LAUNCHER names the persistent AppImage (not this run's temporary
# mount) for background starts and the "Run at startup" entry.
set -eu
APPDIR=$(dirname "$(readlink -f -- "$0")")
case "${APPIMAGE:-}" in
    /*) JUMPKUT_LAUNCHER=$APPIMAGE ;;
    *) JUMPKUT_LAUNCHER=$APPDIR/AppRun ;;
esac
export APPDIR JUMPKUT_LAUNCHER
exec "$APPDIR/usr/bin/jumpkut" "$@"
