#!/bin/sh
# Always derive the current mount from this launcher. A detached AppImage child
# inherits environment variables pointing at the parent's soon-to-close mount.
set -eu
APPDIR=$(dirname "$(readlink -f -- "$0")")
export APPDIR
case "${APPIMAGE:-}" in
    /*) JUMPKUT_LAUNCHER=$APPIMAGE ;;
    *) JUMPKUT_LAUNCHER=$APPDIR/AppRun ;;
esac
export JUMPKUT_LAUNCHER

# Use only the interpreter, modules and native libraries shipped in this image.
# Leave the user's XDG config/data/state locations untouched.
export PYTHONHOME="$APPDIR/usr"
export PYTHONPATH="$APPDIR/usr/lib/python3/dist-packages:$APPDIR/usr/share/jumpkut"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export LD_LIBRARY_PATH="$APPDIR/usr/lib"
export GI_TYPELIB_PATH="$APPDIR/usr/lib/girepository-1.0"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export GTK_DATA_PREFIX="$APPDIR/usr"
export GTK_EXE_PREFIX="$APPDIR/usr"
export GTK_PATH="$APPDIR/usr/lib/gtk-3.0"
export GDK_BACKEND=x11
export GTK_THEME="${APPIMAGE_GTK_THEME:-Adwaita}"
export XDG_DATA_DIRS="$APPDIR/usr/share:/usr/local/share:/usr/share"
unset GTK_MODULES GTK3_MODULES GIO_EXTRA_MODULES GIO_MODULE_DIR PYTHONUSERBASE

# GTK caches contain absolute loader paths. Generate them for this mount rather
# than embedding the build machine's paths or sharing caches between instances.
runtime_cache=$(mktemp -d "${TMPDIR:-/tmp}/jumpkut-appimage.XXXXXXXX")
trap 'rm -rf -- "$runtime_cache"' EXIT
export GDK_PIXBUF_MODULEDIR="$APPDIR/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders"
export GDK_PIXBUF_MODULE_FILE="$runtime_cache/loaders.cache"
export GTK_IM_MODULE_FILE="$runtime_cache/immodules.cache"
"$APPDIR/usr/bin/gdk-pixbuf-query-loaders" "$GDK_PIXBUF_MODULEDIR"/*.so > "$GDK_PIXBUF_MODULE_FILE"
"$APPDIR/usr/bin/gtk-query-immodules-3.0" "$APPDIR/usr/lib/gtk-3.0/3.0.0/immodules"/*.so > "$GTK_IM_MODULE_FILE"

# Do not exec: this wrapper removes its private loader caches when Python exits.
# The background launch in Jumpkut runs JUMPKUT_LAUNCHER again for its own mount.
"$APPDIR/usr/bin/python3" -m jumpkut "$@"
