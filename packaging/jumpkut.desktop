[Desktop Entry]
Type=Application
Name=Jumpkut
Comment=Clipboard history and quick selection
Exec=jumpkut --history
TryExec=jumpkut
Icon=jumpkut
Terminal=false
Categories=Utility;
Keywords=clipboard;history;copy;paste;
StartupWMClass=jumpkut
StartupNotify=false
X-KDE-Wayland-Interfaces=org_kde_kwin_fake_input
